; eww config file for calendar popup
(defvar calendar-popup-visibility false)

; Calendar popup window
(window
  :id "calendar-popup"
  :monitor 0
  :geometry "250x300+500+100"
  :layer "top"
  :visible false

  ; Background with blur effect
  (box 
    :class "popup-bg" 
    :halign "center" 
    :valign "center"
    :margin-top 10
    :margin-bottom 10
    :margin-left 10
    :margin-right 10
    
    ; Calendar content box with rounded corners and blur
    (box 
      :class "calendar-box"
      :orientation "vertical"
      :spacing 10
      
      ; Date display
      (label 
        :id "current-date"
        :text "Sat, 10 Aug 2026" 
        :class "date-label")
      
      ; Calendar grid with month name
      (box
        :orientation "vertical"
        :spacing 5
        
        ; Month and year title
        (label
          :id "month-year"
          :text "August 2026"
          :class "month-year-label"
          :halign "center")
          
        ; Day names
        (box
          :orientation "horizontal"
          :spacing 2
          (label :text "S" :class "day-label") 
          (label :text "M" :class "day-label") 
          (label :text "T" :class "day-label")
          (label :text "W" :class "day-label") 
          (label :text "T" :class "day-label") 
          (label :text "F" :class "day-label") 
          (label :text "S" :class "day-label"))
        
        ; Calendar dates - simplified grid
        (box
          :orientation "horizontal"
          :spacing 2
          :class "calendar-grid"
          
          ; First row (empty cells for days before the 1st)
          (label :text "" :class "empty-day") 
          (label :text "" :class "empty-day")
          (label :text "" :class "empty-day")  
          (label :text "" :class "empty-day")
          (label :text "" :class "empty-day")
          (label :text "1" :class "calendar-day")
          (label :text "2" :class "calendar-day")
        )
        
        (box
          :orientation "horizontal"
          :spacing 2
          :class "calendar-grid"
           (label :text "3" :class "calendar-day")
           (label :text "4" :class "calendar-day")  
           (label :text "5" :class "calendar-day") 
           (label :text "6" :class "calendar-day")
           (label :text "7" :class "calendar-day")
           (label :text "8" :class "calendar-day")
           (label :text "9" :class "calendar-day")
        )
        
        (box
          :orientation "horizontal"
          :spacing 2
          :class "calendar-grid"
           (label :text "10" :class "calendar-day")
           (label :text "11" :class "calendar-day")  
           (label :text "12" :class "calendar-day") 
           (label :text "13" :class "calendar-day")
           (label :text "14" :class "calendar-day")
           (label :text "15" :class "calendar-day")
           (label :text "16" :class "calendar-day")
        )
        
        (box
          :orientation "horizontal"
          :spacing 2
          :class "calendar-grid"
           (label :text "17" :class "calendar-day")
           (label :text "18" :class "calendar-day")  
           (label :text "19" :class "calendar-day") 
           (label :text "20" :class "calendar-day")
           (label :text "21" :class "calendar-day")
           (label :text "22" :class "calendar-day")
           (label :text "23" :class "calendar-day")
        )
        
        (box
          :orientation "horizontal"
          :spacing 2
          :class "calendar-grid"
           (label :text "24" :class "calendar-day")
           (label :text "25" :class "calendar-day")  
           (label :text "26" :class "calendar-day") 
           (label :text "27" :class "calendar-day")
           (label :text "28" :class "calendar-day")
           (label :text "29" :class "calendar-day")
           (label :text "30" :class "calendar-day")
        )
        
        (box
          :orientation "horizontal"
          :spacing 2
          :class "calendar-grid"
           (label :text "31" :class "calendar-day")
           (label :text "" :class "empty-day")  
           (label :text "" :class "empty-day") 
           (label :text "" :class "empty-day")
           (label :text "" :class "empty-day")
           (label :text "" :class "empty-day")
           (label :text "" :class "empty-day")
        )
      )
      
      ; Current time
      (label 
        :id "current-time"
        :text "14:30:25" 
        :class "time-label")
    )
  )
)